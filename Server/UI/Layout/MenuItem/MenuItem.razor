
@inherits MenuItemBase

@if (MenuItem.SubMenuItems.Any())
{
    <MenuHeader MenuItem="@MenuItem" />
}
else
{
    <li class="flex items-center justify-between mb-2 rounded-md border-b-2 border-slate-200 bg-slate-50 hover:border-l-4 border-l-blue-400 hover:bg-blue-100 duration-150">
        <NavLink href="@MenuItem.Href" ActiveClass="active" Match="NavLinkMatch.All" class="flex items-center gap-2 w-full py-2 px-2 rounded">
            <img src="@MenuItem.Icon" width="28" height="28" aria-hidden="true" alt="icon" /> @MenuItem.Title
        </NavLink>
    </li>
}
