@inherits MenuHeaderBase

<li class="h-auto @ParentBottomMargin">
        <button class="cursor-pointer px-2 w-full flex items-center justify-between rounded-md min-h-14 border-b-2 border-slate-200" @onclick="ToggleSubMenuItems">
            <img src="@MenuItem.Icon" width="32" height="32" aria-hidden="true" alt="icon" />
            <span>@MenuItem.Title</span>
            @if (IsOpen)
            {
                <img src="icons/chevron_up.svg" width="24" height="24" aria-hidden="true" alt="Togglar undermeny" />
            }
            else
            {
                <img src="icons/chevron_down.svg" width="24" height="24" aria-hidden="true" alt="Togglar undermeny" />
            }
        </button>

    <div class="submenu-wrapper @(IsOpen ? "submenu-wrapper-open" : "")">
        <ul class="ms-10 flex flex-col py-2">
            @foreach (MenuItemModel subMenuItem in MenuItem.SubMenuItems)
            {
                <li>
                    <MenuItem MenuItem="@subMenuItem"/>
                </li>
            }
        </ul>
    </div>
</li>