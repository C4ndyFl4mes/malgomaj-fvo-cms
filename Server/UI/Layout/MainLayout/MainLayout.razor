@using Server.API.Routes.Internal.Authentication
@using Server.Enums
@using Server.UI.Components.ConfirmationOverlay
@using Server.UI.States
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject OverlayHostState OverlayHostState
@inject IJSRuntime JS

<div class="flex flex-col min-h-screen">
    <div class="flex flex-1">
        <Sidebar />
        <div class="flex-1 flex flex-col">
            <div class="flex flex-row justify-between">
                <Breadcrumbs />
                <button class="button-1 bg-blue-400 cursor-pointer m-2.5" @onclick="OpenSignOutOverlay">Logga ut</button>
            </div>
            <main class="flex-1 p-4 container mx-auto">
                @Body
            </main>
        </div>
    </div>
</div>

@* <div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div> *@

@code {
    private (bool IsSuccess, string Message) ResultMessage { get; set; } = (false, string.Empty);

    private IJSObjectReference _authModule { get; set; } = default!;

    // Starts the refresh cycle and sends a HTTP-request every five minutes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _authModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/otherJS/auth.js");
            await _authModule.InvokeVoidAsync("authRefreshCycle.start", 5);
        }
    }

    // Opens the overlay for signing out.
    private void OpenSignOutOverlay()
    {
        OverlayHostState.Append(new()
        {
            Id = Guid.NewGuid(),
            ComponentType = typeof(ConfirmationOverlay),
            Parameters = new Dictionary<string, object>
            {
                ["Message"] = "Vill du logga ut?",
                ["AcceptBtnText"] = "Logga ut",
                ["IsDanger"] = false,
                ["OnAccept"] = EventCallback.Factory.Create(this, SignOut)
            }
        });
    }

    // Signs out the user and navigates the user to the /admin page.
    private async Task SignOut()
    {
        ClientCallResponse<AuthenticationResponse> response = await
            _authModule.InvokeAsync<ClientCallResponse<AuthenticationResponse>>("signout");
        if (!response.IsSuccess || response.Data is null)
        {
            OverlayHostState.Append(new()
            {
                Id = Guid.NewGuid(),
                ComponentType = typeof(QuickOverlay),
                Parameters = new Dictionary<string, object>
                {
                    ["Message"] = response.Error?.Detail ?? "Ett oväntat fel inträffade.",
                    ["Selection"] = QuickOverlaySelection.Error
                }
            });
        }
        else
        {
            OverlayHostState.Append(new()
            {
                Id = Guid.NewGuid(),
                ComponentType = typeof(QuickOverlay),
                Parameters = new Dictionary<string, object>
                {
                    ["Message"] = response.Data.Message,
                    ["Selection"] = QuickOverlaySelection.Success
                }
            });

            await _authModule.InvokeVoidAsync("authRefreshCycle.stop");
        }
        NavigationManager.NavigateTo("/admin");
    }
}