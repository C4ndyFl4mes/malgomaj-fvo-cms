@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using Server.UI.Layout.AuthenticationLayout
@attribute [AllowAnonymous]
@layout AuthenticationLayout
@inherits AuthPageBase

<form class="w-100 p-5 mx-auto mt-[5%] shadow-lg rounded-xl">
    <fieldset class="w-full flex flex-col">
        <legend class="font-bold">Autentiseringsformulär</legend>
        <div class="flex flex-col gap-y-5 my-5">
            <div class="flex flex-col">
                <label for="email-authfield">E-post:</label>
                <input type="email" id="email-authfield" name="email" autocomplete="email"
                       @bind-value="AuthFields.Email" class="bg-slate-100 rounded-md leading-8 px-2" />

                @if (ValidationErrors.ContainsKey("email"))
                {
                    <div class="error">
                        <span>@ValidationErrors["email"][0]</span>
                    </div>
                }

            </div>
            <div class="flex flex-col">
                <label for="password-authfield">Lösenord:</label>
                <input type="password" id="password-authfield" name="password" autocomplete="current-password"
                       @bind-value="AuthFields.Password" class="bg-slate-100 rounded-md leading-8 px-2" />
                
                @if (ValidationErrors.ContainsKey("password"))
                {
                    <div class="error">
                        <ul>
                            @foreach (string error in ValidationErrors["password"])
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

            </div>
        </div>
        <button type="button" @onclick="AuthenticateAsync"
                class="button-1 bg-blue-300 mx-auto cursor-pointer">
            Logga in
        </button>
        @if (ResultMessage.Message != string.Empty)
        {
            @if (ResultMessage.IsSuccess)
            {
                <div class="success">
                    <span>@ResultMessage.Message</span>
                </div>
            }
            else
            {
                <div class="error">
                    <span>@ResultMessage.Message</span>
                </div>
            }
        }
    </fieldset>
</form>