@page "/admin/content/pages"
@inherits PagesBase

<PageTitle>Sidor</PageTitle>

<h1 class="text-3xl">Sidor</h1>

<div class="h-50 w-full flex gap-x-4 border-t-2 border-slate-50 shadow-lg rounded-2xl">
    <NavLink href="@Href" class="h-full aspect-square flex items-center justify-center bg-slate-100 rounded-l-2xl hover:brightness-95 active:brightness-90 duration-200">
        <img src="/icons/add.svg" alt="Add ikon" width="100" height="100" title="Nytt utkast" />
    </NavLink>
    <div class="flex flex-col">
        <h2 class="text-2xl">Utkast</h2>
        <div class="flex flex-nowrap gap-x-2 overflow-x-auto my-auto">
            @if (DraftPages.Any())
            {
                @foreach (PageItem page in DraftPages)
                {
                    <NavLink href="@($"/admin/content/pages/edit/{page.PageId}")"
                             class="h-35 relative aspect-square flex flex-col items-center border-2 rounded-md border-slate-100 bg-slate-50 overflow-hidden hover:border-yellow-300 duration-200"
                             title="@(page.Title)">
                        <h3 class="text-md bg-slate-100 font-bold">@(TitleExcerpt(page.Title))</h3>
                        <img src="/icons/page_content.svg" alt="Sidikon" width="100" height="100" class="h-full" />
                        <small class="absolute bottom-0 right-1 text-xs">@(page.SavedAt.ToLocalTime().ToString("yyyy-MM-dd H:mm"))</small>
                    </NavLink>
                }
            }
        </div>
    </div>
</div>

<div class="min-h-100 border-t-2 border-slate-50 shadow-lg rounded-2xl mt-10">
    <h2 class="text-2xl m-2">Publicerade sidor</h2>
    <div class="flex flex-wrap gap-2 p-5 pt-2">
        @if (Errors.Keys.Contains("loadPages"))
        {
            <ul class="error">
                @foreach (string error in Errors["loadPages"])
                {
                    <li>@error</li>
                }
            </ul>
        }
        else if (PublishedPages.Any())
        {
            @foreach (PageItem page in PublishedPages)
            {
                <NavLink href="@($"/admin/content/pages/edit/{page.PageId}")"
                         class="h-35 relative aspect-square flex flex-col items-center border-2 rounded-md border-slate-100 bg-slate-50 overflow-hidden hover:border-yellow-300 duration-200"
                         title="@(page.Title)">
                    <h3 class="text-md bg-slate-100 font-bold">@(TitleExcerpt(page.Title))</h3>
                    <img src="/icons/page_content.svg" alt="Sidikon" width="100" height="100" class="h-full" />
                    <small class="absolute bottom-0 right-1 text-xs">@(page.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd H:mm"))</small>
                </NavLink>
            }
        }
        else
        {
            <div class="mx-auto mt-[20%]">
                <img src="/icons/info.svg" alt="Info ikon" width="100" height="100" />
                <p>Det finns inga publicerade sidor än.</p>
            </div>
        }
    </div>
</div>